# Copy to .env and fill in. Names only — never commit real values. Full list: docs/TRD.md §7.

# --- required -----------------------------------------------------------------------------
APP_ENV=dev                                   # dev | prod | test — prefixes PayPal-Request-Id keys
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com   # sandbox only: anything else refuses to start
DATABASE_URL=                                 # Postgres (Neon pooled URL), used by the app
DATABASE_URL_UNPOOLED=                        # direct URL, used only by `alembic upgrade head`

# --- PayPal sandbox (developer.paypal.com → Apps & Credentials → Sandbox) -----------------
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BUSINESS_EMAIL=                        # the sandbox business account (the invoicer)
PAYPAL_WEBHOOK_ID=                            # only where PayPal can reach the api (Render)
SANDBOX_BUYER_EMAIL=                          # the sandbox personal account demo buyers pay with
SANDBOX_BUYER_PASSWORD=                       # shown on the demo page (sandbox only)

# --- AI (Meta Model API) -------------------------------------------------------------------
LLM_API_KEY=
LLM_MODEL=muse-ember-1.0
LLM_REASONING_EFFORT=low

# --- app -----------------------------------------------------------------------------------
APP_BASE_URL=http://localhost:3000            # the web address (statement links in invoices)
API_PUBLIC_URL=http://localhost:8000          # the api's public address (webhooks)
SUPPLIER_NAME=Demo Diamond Co.
DEMO_MODE=true
ADMIN_TOKEN=                                  # supplier admin (import, admin lists)
DEMO_COOKIE_SECRET=                           # any long random string
IP_HASH_SECRET=                               # any long random string

# --- tests (optional) ----------------------------------------------------------------------
TEST_DATABASE_URL=                            # a separate test database — never dev or prod
REQUIRE_TEST_DB=                              # CI sets 1: database tests fail instead of skipping
